<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="ADB Diag"
        android:icon="@android:drawable/ic_menu_manage"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- persist.sv.debug.adb_enable/adb_wifi_enabled переживают перезагрузку
             сами (setprop persist.*/Settings.Global), но повторяем попытку и
             тут на каждой загрузке — вдруг свойство почему-то сбросилось, а
             WRITE_SECURE_SETTINGS у этого приложения (выданный один раз через
             pm grant во время установки) сохраняется между загрузками. -->
        <receiver android:name=".BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
