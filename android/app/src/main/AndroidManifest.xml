<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="true" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Для MulticastLock (см. MdnsResolve.kt) — без него система тихо
         фильтрует входящие multicast-пакеты для приложения. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Без этих двух ConnectivityManager.getLinkProperties()/allNetworks()
         и WifiManager.createMulticastLock() либо бросают SecurityException,
         либо тихо возвращают пусто — ИМЕННО так и ломался скан сети
         (NetworkScan.kt/MdnsResolve.kt), без единой строчки в логе, потому
         что вызовы обёрнуты в try/catch без логирования. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Служба «Идёт установка» (OperationService.kt): свёрнутую программу без неё Android замораживает посреди
         заливки (логи 14.10: по Wi-Fi обрыв в 29 из 43 случаев). Тип connectedDevice — работа с магнитолой по USB/Wi-Fi;
         его условие на Android 14+ выполняет CHANGE_WIFI_MULTICAST_STATE выше. WAKE_LOCK — для WakeLock/WifiLock. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.MagicSqdMobile"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Не launcher — доступен через
             adb shell am start -n ru.magicsqd.mobile/.DiagnosticsActivity
             exported=false: "adb shell am start" по-прежнему работает (shell
             UID имеет отдельное системное разрешение запускать неэкспортированные
             компоненты), а вот ЛЮБОЕ ДРУГОЕ приложение на телефоне — уже нет.
             С exported=true этот экран (кнопки "стереть флешку"/"поставить
             APK по ADB", без единого подтверждения) был доступен по имени
             компонента вообще любому установленному на устройстве приложению
             — нашли при аудите проекта, не было умышленно. -->
        <activity
            android:name=".DiagnosticsActivity"
            android:exported="false" />

        <!-- На время операции с магнитолой (WebBridge.runExclusive → OperationKeeper). stopWithTask: смахнули
             программу из недавних — служба гаснет, как раньше гасла и сама программа. -->
        <service
            android:name=".OperationService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice"
            android:stopWithTask="true" />

        <!-- Снимок для фото экрана ИИ-помощнику (MainActivity.cameraIntent): камера пишет в cache/photos/ по этому
             адресу, своё разрешение на камеру программе не нужно. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
