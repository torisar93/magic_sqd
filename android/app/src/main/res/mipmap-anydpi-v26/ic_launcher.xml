<?xml version="1.0" encoding="utf-8"?>
<!-- Прозрачный background — иначе часть лаунчеров (MIUI/HyperOS и т.п.)
     подставляет свою белую подложку под легаси-иконки без адаптивного
     дескриптора; с ним система сама маскирует форму (круг/сквиркл/квадрат)
     без лишнего фона. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@android:color/transparent" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
