# Виртуальное окружение и кэш Python
.venv/
__pycache__/
*.pyc

# Артефакты сборки PyInstaller (пересобираются из magic_sqd.spec)
build/
dist/

# platform-tools (adb.exe и спутники) — качаются отдельно, см. tools/README.txt
tools/*.exe
tools/*.dll

# отдельная копия platform-tools под Windows 7-сборку (старее, см. tools_win7/README.txt)
tools_win7/*.exe
tools_win7/*.dll

# Служебные файлы Claude Code (локальные настройки/скиллы, не часть продукта)
.claude/
.agents/
skills-lock.json

# Собственные dev-инструменты автора (ADB sniffer/fake-device для
# тестирования install.py/stages.py без реального железа) — не часть
# самой программы, не для публичного репозитория.
devtools/
adb_sniffer.spec
fake_adb_device.spec

# Логи с этой конкретной машины — не для репозитория
crash.log
startup.log
*.log

# Сами APK в git не кладём (среди них попадаются очень большие файлы,
# GitHub вообще блокирует пуш файлов больше 100 МБ). Программа и так
# читает их прямо с диска — этот .gitignore только про сам репозиторий.
# Файлы остаются на диске у пользователя и нормально работают в
# программе; бэкапить APK нужно отдельно (см. обсуждение — облако +
# скачивание по запросу). "**" — не только apk/*.apk, но и вложенные
# категории (apk/Утилиты/*.apk и т.п.) — плоский "*" их не ловил, из-за
# чего вся общая библиотека годами копилась как untracked-мусор в
# рабочей копии (см. аудит проекта). Метаданные (.json рядом с каждым
# .apk — имя/описание) той же природы, тоже не для git.
apk/**/*.apk
apk/**/*.json
cars/**/*.apk

# Ключ подписи Android-приложения (см. android/app/build.gradle.kts:
# keystoreProps читает rootDir/keystore/keystore.properties) — секрет
# уровня "кто угодно с этим ключом может подписать поддельное обновление,
# которое Android сочтёт легитимным", ни в коем случае не в публичный
# репозиторий. До этой правки папка вообще не была в .gitignore.
keystore/
*.jks
*.keystore

# Маркер-файл для подробного debug_all.log (main_web.py:
# _enable_debug_log_all, см. installer_debug.iss) и сам временный
# дебаг-инсталлятор — рабочие dev-инструменты конкретной машины
# разработчика, не для репозитория.
DEBUG_LOG_ALL
installer_debug.iss

# Тяжёлые файлы конкретных моделей (прошивки, ISO, USB-инсталляторы —
# то же самое, что Excludes в installer.iss уже держит вне самого
# инсталлятора) — живут только на своём сервере (см. server/README.md,
# content_sync.py), в git не попадают вовсе. Среди них попадаются файлы
# по 500+ МБ (например, ISO прошивки HAVAL M6) — GitHub такое не примет.
# README.txt-заглушки — исключение, чтобы структура пустых папок были
# видна в самом репозитории (см. cars/*/files/*/README.txt).
cars/**/files/**
cars/**/usb_files/**
# Поддиректории нужно переисключить отдельно (git не спускается внутрь
# уже исключённой директории, даже если файл внутри переисключён ниже) —
# см. https://git-scm.com/docs/gitignore, "It is not possible to
# re-include a file if a parent directory of that file is excluded".
!cars/**/files/**/
!cars/**/usb_files/**/
!cars/**/files/**/README.txt
!cars/**/usb_files/**/README.txt

# Реальные машины пользователей — их не выкладываем в публичный репозиторий
# вообще, ни install.py/stages.py, ни что-либо ещё (см. cars/**/files и
# cars/**/usb_files выше — это только про тяжёлые файлы, а это правило про
# сами модели). cars/_shared/ — единственное исключение: общие
# скрипты-хелперы (wifi_adb.py и т.п.), это часть самой программы, а не
# чей-то реальный автомобиль. cars/Demo/ (демо-модель для примера) удалена
# насовсем — путалась с настоящими машинами в списке у техников.
cars/*/
!cars/_shared/

# Секреты/адреса своего сервера — свои для каждого окружения (см. server/README.md)
server.json
submit.json
admin.json

# Сохранённый логин/пароль админки ("Запомнить меня" на обязательном экране
# входа admin-сборки, см. app/admin_config.py) — секрет конкретной машины.
admin_saved_login.json

# Приватный ключ и конфиг публикации в RuStore (public-api.rustore.ru) —
# секрет конкретной машины, как и остальные *.json выше.
rustore_key.pem
rustore.json

# Анонимный id конкретной установки для счётчика пользователей (см.
# app/ping_client.py) — генерируется программой сама при первом запуске
client_id.txt

# Какие ревизии моделей техник уже видел (см. app/update_tracker.py,
# сводка "Что нового" при старте) — состояние конкретной установки, не
# часть репозитория
seen_versions.json

# Серверную часть (backend.py, админка, nginx-конфиг, systemd-юнит) не
# выкладываем в публичный репозиторий — это отдельная приватная
# инфраструктура (VPS), а не часть самой программы. Файлы остаются на
# диске у разработчика и на самом VPS, деплоятся вручную (см. server/README.md).
server/

# Собранный инсталлятор (пересобирается из installer.iss)
installer_output/

# То же самое, для Windows 7 (x86, PySide2/Qt5, Python 3.8)-сборки — см.
# main_web_win7.py, magic_sqd_win7.spec, installer_win7_x86.iss.
.venv-win7/
build_win7/
dist_win7/
