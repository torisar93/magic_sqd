# Виртуальное окружение и кэш Python
.venv/
__pycache__/
*.pyc

# Артефакты сборки PyInstaller (пересобираются из magic_sqd.spec)
build/
dist/

# platform-tools (adb.exe и спутники) — качаются отдельно, см. tools/README.txt
tools/*.exe
tools/*.dll

# Служебные файлы Claude Code (локальные настройки/скиллы, не часть продукта)
.claude/
.agents/
skills-lock.json

# Собственные dev-инструменты автора (ADB sniffer/fake-device для
# тестирования install.py/stages.py без реального железа) — не часть
# самой программы, не для публичного репозитория.
devtools/
adb_sniffer.spec
fake_adb_device.spec

# Логи с этой конкретной машины — не для репозитория
crash.log
startup.log
*.log

# Сами APK в git не кладём (среди них попадаются очень большие файлы,
# GitHub вообще блокирует пуш файлов больше 100 МБ). Программа и так
# читает их прямо с диска — этот .gitignore только про сам репозиторий.
# Файлы остаются на диске у пользователя и нормально работают в
# программе; бэкапить APK нужно отдельно (см. обсуждение — облако +
# скачивание по запросу).
apk/*.apk
cars/**/*.apk

# Тяжёлые файлы конкретных моделей (прошивки, ISO, USB-инсталляторы —
# то же самое, что Excludes в installer.iss уже держит вне самого
# инсталлятора) — живут только на своём сервере (см. server/README.md,
# content_sync.py), в git не попадают вовсе. Среди них попадаются файлы
# по 500+ МБ (например, ISO прошивки HAVAL M6) — GitHub такое не примет.
# README.txt-заглушки — исключение, чтобы структура пустых папок были
# видна в самом репозитории (см. cars/*/files/*/README.txt).
cars/**/files/**
cars/**/usb_files/**
# Поддиректории нужно переисключить отдельно (git не спускается внутрь
# уже исключённой директории, даже если файл внутри переисключён ниже) —
# см. https://git-scm.com/docs/gitignore, "It is not possible to
# re-include a file if a parent directory of that file is excluded".
!cars/**/files/**/
!cars/**/usb_files/**/
!cars/**/files/**/README.txt
!cars/**/usb_files/**/README.txt

# Секреты/адреса своего сервера — свои для каждого окружения (см. server/README.md)
server.json
submit.json
admin.json

# Анонимный id конкретной установки для счётчика пользователей (см.
# app/ping_client.py) — генерируется программой сама при первом запуске
client_id.txt

# Серверную часть (backend.py, админка, nginx-конфиг, systemd-юнит) не
# выкладываем в публичный репозиторий — это отдельная приватная
# инфраструктура (VPS), а не часть самой программы. Файлы остаются на
# диске у разработчика и на самом VPS, деплоятся вручную (см. server/README.md).
server/

# Собранный инсталлятор (пересобирается из installer.iss)
installer_output/
